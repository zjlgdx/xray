#!/usr/bin/env bash
set -euo pipefail
SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
HERE="$(cd "$(dirname "${SCRIPT_PATH}")/.." && pwd)"
. "${HERE}/lib/core.sh"
usage() {
  cat << EOF
xrf — Xray Fusion Lite (complete clean)
Usage: xrf <command>
  install     Install Xray & deploy confdir (atomic, flock-protected)
  upgrade     Upgrade only the core, preserving config (requires --version)
  status      Show version & active confdir
  uninstall   Remove Xray (keep state)
  links       Print client links
  logs        View, filter, and export Xray logs
  backup      Manage configuration backups
  check       Validate config (supports --deep pipeline)
  test-sni    Test SNI domain for REALITY protocol compatibility
  health      Run post-installation health check
  help        Show this help
EOF
}
cmd="${1-}"
shift || true

case "${cmd}" in
  install) "${HERE}/commands/install.sh" "$@" ;;
  upgrade) "${HERE}/services/xray/upgrade.sh" "$@" ;;
  status) "${HERE}/commands/status.sh" "$@" ;;
  uninstall) "${HERE}/commands/uninstall.sh" "$@" ;;
  links) "${HERE}/services/xray/client-links.sh" "$@" ;;
  logs) "${HERE}/commands/logs.sh" "$@" ;;
  backup) "${HERE}/commands/backup.sh" "$@" ;;
  check) "${HERE}/commands/check.sh" "$@" ;;
  test-sni) "${HERE}/commands/test-sni.sh" "$@" ;;
  health) "${HERE}/commands/health.sh" "$@" ;;
  help | "") usage ;;
  *)
    usage
    exit 2
    ;;
esac
